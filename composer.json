{
  "name": "makarms/text-probe",
  "description": "Simple and extensible PHP library for text analysis and pattern matching, designed to help developers probe, parse, and manipulate text efficiently.",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Makar Mikhalchenko",
      "email": "makar.mikhalchenko@bk.ru"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
    "ergebnis/composer-normalize": "^2.58",
    "friendsofphp/php-cs-fixer": "^3.95.32",
    "icanhazstring/composer-unused": "^0.9.7",
    "infection/infection": "^0.35.12",
    "phpcompatibility/php-compatibility": "10.0.0-alpha3",
    "phpstan/phpstan": "^2.3.7",
    "phpstan/phpstan-strict-rules": "^2.1.1",
    "phpunit/phpunit": "^13.4.8",
    "squizlabs/php_codesniffer": "^4.0.4"
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "Tests\\": "tests/",
      "TextProbe\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "infection/extension-installer": true
    }
  },
  "scripts": {
    "cs:check": "php-cs-fixer fix --verbose --config=.php-cs-fixer.dist.php --dry-run --diff",
    "cs:fix": "php-cs-fixer fix --verbose --config=.php-cs-fixer.dist.php",
    "phpcs": "vendor/bin/phpcs",
    "phpstan": "phpstan analyse -c phpstan.dist.neon --memory-limit=512M -v"
  }
}
